#!/usr/bin/env python3
"""
Pretend rclone for tests: every "<remote>:<path>" is a folder under $FAKE_DRIVE.
Supports: lsjson [-R] [--files-only], lsd, copy, copyto, move, moveto, deletefile, delete [--min-age Nd],
rmdirs [--leave-root], cat, mkdir. Every call is appended to $FAKE_RCLONE_LOG (one JSON list per line).
With --use-json-log it prints one rclone-style JSON stats line to stderr.
"""
import json
import os
import re
import shutil
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(os.environ.get("FAKE_DRIVE", "/tmp/fake-drive"))
args = sys.argv[1:]
if os.environ.get("FAKE_RCLONE_LOG"):
    with open(os.environ["FAKE_RCLONE_LOG"], "a") as f:
        f.write(json.dumps(args) + "\n")

flags = [a for a in args if a.startswith("-")]
VALUE_FLAGS = {"--min-age", "--stats", "--stats-log-level", "--config", "--log-file", "--log-level"}
pos, skip = [], False
for a in args:
    if skip:
        skip = False
        continue
    if a in VALUE_FLAGS:
        skip = True
        continue
    if not a.startswith("-"):
        pos.append(a)
cmd, rest = pos[0], pos[1:]


def path(p):
    m = re.match(r"^([A-Za-z0-9_-]{2,}):(.*)$", p)
    return (ROOT / m.group(2).lstrip("/")) if m else Path(p)


def flag_value(name):
    return args[args.index(name) + 1] if name in args else None


def stats(size):
    if "--use-json-log" in args:
        print(json.dumps({"level": "info", "msg": "stats", "stats": {"bytes": size, "totalBytes": size,
                                                                       "transfers": 1}}), file=sys.stderr)


def entry(p, base):
    st = p.stat()
    return {"Path": str(p.relative_to(base)), "Name": p.name, "Size": st.st_size if p.is_file() else -1,
            "ModTime": datetime.fromtimestamp(st.st_mtime, timezone.utc).isoformat().replace("+00:00", "Z"),
            "IsDir": p.is_dir(), "MimeType": "video/mp4" if p.suffix == ".mp4" else ""}


if cmd == "lsjson":
    base = path(rest[0])
    if not base.exists():
        print("directory not found", file=sys.stderr)
        sys.exit(3)
    items = base.rglob("*") if "-R" in args or "--recursive" in args else base.iterdir()
    out = [entry(p, base) for p in sorted(items) if not ("--files-only" in args and p.is_dir())]
    print(json.dumps(out))
elif cmd == "lsd":
    base = path(rest[0] if rest else "x:")
    for p in sorted(base.iterdir()) if base.exists() else []:
        if p.is_dir():
            print(f"          -1 2000-01-01 00:00:00        -1 {p.name}")
elif cmd == "cat":
    p = path(rest[0])
    if not p.is_file():
        sys.exit(3)
    sys.stdout.write(p.read_text(encoding="utf-8"))
elif cmd == "mkdir":
    path(rest[0]).mkdir(parents=True, exist_ok=True)
elif cmd in ("copy", "move"):
    src, dst = path(rest[0]), path(rest[1])
    if not src.exists():
        sys.exit(3)
    dst.mkdir(parents=True, exist_ok=True)
    files = [src] if src.is_file() else [p for p in src.iterdir() if p.is_file()]
    for f in files:
        shutil.copy2(f, dst / f.name)
        stats(f.stat().st_size)
        if cmd == "move":
            f.unlink()
elif cmd in ("copyto", "moveto"):
    src, dst = path(rest[0]), path(rest[1])
    if not src.is_file():
        sys.exit(3)
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dst)
    stats(src.stat().st_size)
    if cmd == "moveto":
        src.unlink()
elif cmd == "deletefile":
    p = path(rest[0])
    if not p.is_file():
        sys.exit(3)
    p.unlink()
elif cmd == "delete":
    base, age = path(rest[0]), flag_value("--min-age")
    days = float(age.rstrip("d")) if age else 0
    for p in list(base.rglob("*")):
        if p.is_file() and time.time() - p.stat().st_mtime >= days * 86400:
            p.unlink()
elif cmd == "rmdirs":
    base = path(rest[0])
    for p in sorted((d for d in base.rglob("*") if d.is_dir()), key=lambda d: -len(d.parts)):
        if not any(p.iterdir()):
            p.rmdir()
    if "--leave-root" not in args and base.exists() and not any(base.iterdir()):
        base.rmdir()
elif cmd == "version":
    print("rclone v1.0.0-fake")
else:
    print(f"fake rclone: unsupported command {cmd}", file=sys.stderr)
    sys.exit(1)
